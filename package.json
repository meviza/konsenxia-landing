{
  "name": "konsenxia-landing",
  "version": "0.1.0",
  "description": "Open-source landing site for KONSENXIA — healthcare AI platform for clinicians.",
  "license": "MIT OR Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/meviza/konsenxia-landing.git"
  },
  "homepage": "https://konsenxia.com",
