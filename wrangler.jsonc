{
  "name": "konsenxia-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "konsenxia.com/*", "zone_name": "konsenxia.com" },
    { "pattern": "www.konsenxia.com/*", "zone_name": "konsenxia.com" }
  ],
  "vars": {
    "NOTIFY_EMAIL": "kerem.newton571@gmail.com",
    "FROM_EMAIL": "noreply@konsenxia.com"
  }
}
